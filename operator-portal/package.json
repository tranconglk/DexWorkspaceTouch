{
  "name": "dexworkspacetouch-operator-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "check": "npm run typecheck && npm run test && npm run deploy:dry-run",
    "db:migrate:local": "wrangler d1 migrations apply dexworkspacetouch-fulfillment --local",
    "db:migrate:remote": "wrangler d1 migrations apply dexworkspacetouch-fulfillment --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.6",
    "@cloudflare/workers-types": "5.20260908.1",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.130.0"
  }
}
