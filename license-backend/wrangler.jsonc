{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dexworkspacetouch-license",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "vars": {
    "APP_PACKAGE_NAME": "com.trancong.dexworkspacetouch",
    "ANDROID_ALLOWED_SIGNING_CERT_SHA256": "19ac0ea99125361b3c2083aaa44c8745ebad9c55fa967642c2b9e5a1086a45e7",
    "LICENSE_SIGNING_KEY_ID": "license-signing-v1"
  },
  "secrets": {
    "required": [
      "LICENSE_KEY_PEPPER",
      "LICENSE_SIGNING_PRIVATE_KEY",
      "LICENSE_SIGNING_PUBLIC_KEY_V1",
      "LICENSE_ADMIN_TOKEN"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "license-db",
      "database_id": "REPLACE_WITH_REMOTE_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "ACTIVATION_LIMITER", "namespace_id": "22001", "simple": { "limit": 100000, "period": 60 } },
    { "name": "PUBLIC_IP_LIMITER", "namespace_id": "22002", "simple": { "limit": 100000, "period": 60 } },
    { "name": "REFRESH_LIMITER", "namespace_id": "22003", "simple": { "limit": 100000, "period": 60 } },
    { "name": "ADMIN_AUTH_LIMITER", "namespace_id": "22004", "simple": { "limit": 100000, "period": 60 } },
    { "name": "ADMIN_UNAUTH_LIMITER", "namespace_id": "22005", "simple": { "limit": 100000, "period": 60 } }
  ],
  "env": {
    "production": {
      "name": "dexworkspacetouch-license-production",
      "workers_dev": true,
      "vars": {
        "APP_PACKAGE_NAME": "com.trancong.dexworkspacetouch",
        "ANDROID_ALLOWED_SIGNING_CERT_SHA256": "19ac0ea99125361b3c2083aaa44c8745ebad9c55fa967642c2b9e5a1086a45e7",
        "LICENSE_SIGNING_KEY_ID": "license-signing-v1",
        "LICENSE_TRUSTED_PUBLIC_KEYS_JSON": "[{\"kid\":\"license-signing-v1\",\"algorithm\":\"RS256\",\"spkiBase64\":\"\"}]"
      },
      "secrets": {
        "required": [
          "LICENSE_KEY_PEPPER",
          "LICENSE_SIGNING_PRIVATE_KEY",
          "LICENSE_SIGNING_PUBLIC_KEY_V1",
          "LICENSE_ADMIN_TOKEN"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dex-workspace-touch-license-prod",
          "database_id": "6d7b7e58-2f3a-477c-bdea-fe819bf34c09",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "ACTIVATION_LIMITER", "namespace_id": "12001", "simple": { "limit": 10, "period": 60 } },
        { "name": "PUBLIC_IP_LIMITER", "namespace_id": "12002", "simple": { "limit": 60, "period": 60 } },
        { "name": "REFRESH_LIMITER", "namespace_id": "12003", "simple": { "limit": 10, "period": 60 } },
        { "name": "ADMIN_AUTH_LIMITER", "namespace_id": "12004", "simple": { "limit": 120, "period": 60 } },
        { "name": "ADMIN_UNAUTH_LIMITER", "namespace_id": "12005", "simple": { "limit": 20, "period": 60 } }
      ]
    }
  }
}
